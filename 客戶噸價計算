<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>紙張噸價計算器</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            padding: 30px;
            width: 100%;
            max-width: 600px;
        }
        h2 {
            text-align: center;
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .form-group {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        .form-group label {
            width: 120px;
            font-weight: bold;
        }
        .form-group input, .form-group select {
            flex: 1;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 16px;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 18px;
            cursor: pointer;
            margin-top: 10px;
            transition: background-color 0.3s;
        }
        button:hover {
            background-color: #2980b9;
        }
        .result-section {
            margin-top: 25px;
            background-color: #e8f4f8;
            padding: 20px;
            border-radius: 8px;
            border-left: 5px solid #3498db;
        }
        .result-item {
            margin-bottom: 10px;
            font-size: 16px;
        }
        .result-item span {
            font-weight: bold;
            color: #d35400;
            font-size: 18px;
        }
        .error {
            color: red;
            text-align: center;
            margin-top: 10px;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>紙張噸價計算器</h2>

    <!-- 輸入區域 -->
    <div class="form-group">
        <label for="spec">規格名稱：</label>
        <input type="text" id="spec" placeholder="例如：銅版紙 (選填)">
    </div>
    <div class="form-group">
        <label for="length">長度：</label>
        <input type="number" id="length" step="0.01" placeholder="輸入長度">
    </div>
    <div class="form-group">
        <label for="width">寬度：</label>
        <input type="number" id="width" step="0.01" placeholder="輸入寬度">
    </div>
    <div class="form-group">
        <label for="ounce">盎司：</label>
        <!-- 已匯入圖片中的所有盎司選項 -->
        <select id="ounce">
            <option value="">請選擇盎司</option>
            <option value="8">8 盎司</option>
            <option value="10">10 盎司</option>
            <option value="12">12 盎司</option>
            <option value="14">14 盎司</option>
            <option value="16">16 盎司</option>
            <option value="18">18 盎司</option>
            <option value="20">20 盎司</option>
            <option value="22">22 盎司</option>
            <option value="24">24 盎司</option>
            <option value="26">26 盎司</option>
            <option value="28">28 盎司</option>
            <option value="30">30 盎司</option>
            <option value="32">32 盎司</option>
            <option value="34">34 盎司</option>
            <option value="36">36 盎司</option>
            <option value="38">38 盎司</option>
            <option value="40">40 盎司</option>
            <option value="42">42 盎司</option>
            <option value="44">44 盎司</option>
            <option value="46">46 盎司</option>
            <option value="48">48 盎司</option>
            <option value="50">50 盎司</option>
            <option value="52">52 盎司</option>
            <option value="54">54 盎司</option>
            <option value="56">56 盎司</option>
        </select>
    </div>
    <div class="form-group">
        <label for="orderQty">客訂張數：</label>
        <input type="number" id="orderQty" placeholder="輸入客訂總張數">
    </div>
    <div class="form-group">
        <label for="unitPrice">客戶單張價：</label>
        <input type="number" id="unitPrice" step="0.0001" placeholder="輸入每張價格">
    </div>

    <button onclick="calculate()">開始計算</button>
    <div id="errorMsg" class="error"></div>

    <!-- 輸出區域 -->
    <div class="result-section" id="resultSection" style="display: none;">
        <div class="result-item">1. 張數 (查表)：<span id="resOunceSheet">0</span> 張</div>
        <div class="result-item">2. 一噸張數：<span id="resTonSheet">0</span> 張</div>
        <div class="result-item">3. 客訂重量：<span id="resWeight">0</span> kg</div>
        <div class="result-item">4. 客訂噸價：<span id="resTonPrice">0</span> 元/噸</div>
    </div>
</div>

<script>
    // 已完整匯入你提供的對照表數據
    const ounceTable = {
        "8": 3760,
        "10": 3000,
        "12": 2480,
        "14": 2120,
        "16": 1880,
        "18": 1680,
        "20": 1500,
        "22": 1365,
        "24": 1240,
        "26": 1156,
        "28": 1060,
        "30": 1002,
        "32": 940,
        "34": 884,
        "36": 835,
        "38": 791,
        "40": 752,
        "42": 716,
        "44": 683,
        "46": 653,
        "48": 626,
        "50": 601,
        "52": 578,
        "54": 557,
        "56": 537
    };

    function calculate() {
        // 清空錯誤訊息
        document.getElementById('errorMsg').innerText = '';

        // 讀取輸入值
        const length = parseFloat(document.getElementById('length').value);
        const width = parseFloat(document.getElementById('width').value);
        const ounce = document.getElementById('ounce').value;
        const orderQty = parseFloat(document.getElementById('orderQty').value);
        const unitPrice = parseFloat(document.getElementById('unitPrice').value);

        // 基本防呆驗證
        if (!length || !width || !ounce || !orderQty || !unitPrice) {
            document.getElementById('errorMsg').innerText = '請填寫所有必要的數值（長、寬、盎司、客訂張數、客戶單張價）。';
            document.getElementById('resultSection').style.display = 'none';
            return;
        }

        if (width === 0) {
            document.getElementById('errorMsg').innerText = '寬度不能為 0。';
            return;
        }

        // 1. 取得查表張數
        const ounceSheets = ounceTable[ounce];
        if (!ounceSheets) {
             document.getElementById('errorMsg').innerText = '找不到該盎司的對應張數，請檢查對照表設定。';
             return;
        }

        // 2. 計算一噸張數：取整數(張數(盎司) * 長 / 寬 * 936)
        const tonSheets = Math.floor((ounceSheets * length / width) * 936);

        // 3. 計算客訂重量：取整數(客訂張數 / 一噸張數 * 1000 + 0.7)
        let orderWeight = 0;
        if (tonSheets > 0) {
            orderWeight = Math.floor((orderQty / tonSheets * 1000) + 0.7);
        }

        // 4. 計算客訂噸價：四捨五入到整數(一噸張數 * 客戶單張價)
        const tonPrice = Math.round(tonSheets * unitPrice);

        // 顯示結果
        document.getElementById('resOunceSheet').innerText = ounceSheets.toLocaleString();
        document.getElementById('resTonSheet').innerText = tonSheets.toLocaleString();
        document.getElementById('resWeight').innerText = orderWeight.toLocaleString();
        document.getElementById('resTonPrice').innerText = tonPrice.toLocaleString();
        
        // 顯示結果區塊
        document.getElementById('resultSection').style.display = 'block';
    }
</script>

</body>
</html>
